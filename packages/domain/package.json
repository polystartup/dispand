{
  "name": "@dispand/domain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./upgrade": "./src/runners/upgrade.ts",
    "./agents/tools": "./src/agents/tools.ts",
    "./platform/bundles": "./src/platform/bundles.ts",
    "./memory/model": "./src/memory/model.ts",
    "./data/*": "./src/data/*.ts",
    "./workflows/*": "./src/workflows/*.ts",
    "./pages/*": "./src/pages/*.ts",
    "./audit/model": "./src/audit/model.ts",
    "./messages/*": "./src/messages/*",
    "./plugins/names": "./src/plugins/names.ts",
    "./test-support": "./src/runners/test-support.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "prepack": "node ../prepare-tarball.mjs assistant/skill && tsc -p tsconfig.pack.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@dispand/runner-protocol": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@orpc/server": "^1.16.2",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.7.25",
    "cron-parser": "^5.10.6",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.58.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "undici": "^8.12.3",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./upgrade": "./dist/runners/upgrade.js",
      "./agents/tools": "./dist/agents/tools.js",
      "./platform/bundles": "./dist/platform/bundles.js",
      "./memory/model": "./dist/memory/model.js",
      "./data/*": "./dist/data/*.js",
      "./workflows/*": "./dist/workflows/*.js",
      "./pages/*": "./dist/pages/*.js",
      "./audit/model": "./dist/audit/model.js",
      "./plugins/names": "./dist/plugins/names.js",
      "./messages/*.json": "./dist/messages/*.json",
      "./messages/*.ts": "./dist/messages/*.js"
    }
  },
  "files": [
    "dist",
    "drizzle/*.sql",
    "drizzle/meta/_journal.json"
  ]
}
