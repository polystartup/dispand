{
  "name": "@dispand/web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/server.d.ts",
      "default": "./dist/server/server.js"
    },
    "./telemetry-preload": "./telemetry-preload.mjs",
    "./shell": {
      "types": "./dist/types/shell/contract.d.ts"
    }
  },
  "imports": {
    "#web-shell": "./src/shell/none.ts"
  },
  "files": [
    "dist",
    "server.ts",
    "telemetry-preload.mjs",
    "telemetry-requests.mjs"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=\"--import ./telemetry-preload.mjs\" vite dev",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "prepack": "tsc -p tsconfig.pack.json",
    "start": "node --import ./telemetry-preload.mjs server.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.37",
    "@assistant-ui/react-markdown": "0.14.26",
