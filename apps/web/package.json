    "@electric-sql/pglite": "^0.5.17",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@orpc/client": "^1.16.4",
    "@orpc/server": "^1.16.4",
    "@orpc/tanstack-query": "^1.16.4",
    "@tanstack/react-form": "^1.33.6",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "^13.0.2",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "generative-frame": "0.0.11",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-i18next": "^18.0.3",
    "srvx": "^1.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@dispand/runner": "workspace:*",
    "@dispand/runner-protocol": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
